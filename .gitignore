# ============================================================
# Python
# ============================================================
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# Environment variables and secrets
# ============================================================
.env
.env.*
!.env.example
*.key
*.pem
service-account*.json
credentials*.json

# ============================================================
# Local data - never commit datasets
# ============================================================
data/raw/*
data/processed/*
data/transformed/*
data/reports/*

# Preserve directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/transformed/.gitkeep
!data/reports/.gitkeep

# ============================================================
# Terraform
# ============================================================
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Never commit real variable values
terraform.tfvars
terraform.tfvars.json

# Keep .terraform.lock.hcl tracked for reproducible providers

# ============================================================
# dbt
# ============================================================
dbt/target/
dbt/dbt_packages/
dbt/logs/*
!dbt/logs/.gitkeep/

# ============================================================
# Docker
# ============================================================
**/.dockerignore